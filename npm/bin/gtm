#!/usr/bin/env node

/**
 * GTM CLI wrapper script
 *
 * npm installs the platform package that matches this machine from
 * optionalDependencies. This script finds its binary and runs it.
 */

const { spawn } = require("child_process");
const path = require("path");

const { name } = require("../package.json");
const platform = `${process.platform}-${process.arch}`;
const SUPPORTED = ["darwin-arm64", "darwin-x64", "linux-x64", "win32-x64"];

function binaryPath() {
  if (!SUPPORTED.includes(platform)) {
    throw new Error(`Unsupported platform: ${platform}. Supported: ${SUPPORTED.join(", ")}.`);
  }
  const pkg = `${name}-${platform}`;
  let manifest;
  try {
    manifest = require.resolve(`${pkg}/package.json`);
  } catch {
    throw new Error(
      `The platform package ${pkg} is not installed.\n` +
        "Reinstall to restore it (do not use --omit=optional or --no-optional):\n" +
        `  npm install -g ${name}`,
    );
  }
  return path.join(path.dirname(manifest), "bin", process.platform === "win32" ? "gtm.exe" : "gtm");
}

let bin;
try {
  bin = binaryPath();
} catch (error) {
  console.error(`GTM CLI: ${error.message}`);
  process.exit(1);
}

const child = spawn(bin, process.argv.slice(2), { stdio: "inherit" });

child.on("close", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
  } else {
    process.exit(code ?? 1);
  }
});

child.on("error", (error) => {
  console.error(`Failed to run GTM CLI: ${error.message}`);
  process.exit(1);
});
